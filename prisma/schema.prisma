generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ایستگاه‌های نشان‌شده (علاقه‌مندی)
model Favorite {
  id        String   @id @default(cuid())
  stationId String
  createdAt DateTime @default(now())

  @@unique([stationId])
}

// مسیرهای روزمره (خانه / محل کار / سفارشی)
model DailyRoute {
  id            String   @id @default(cuid())
  kind          String // home | work | custom
  label         String
  fromStationId String
  toStationId   String
  fromName      String
  toName        String
  createdAt     DateTime @default(now())
}

// تاریخچه سفرها
model TripHistory {
  id            String   @id @default(cuid())
  fromStationId String
  fromName      String
  toStationId   String
  toName        String
  minutes       Int
  transfers     Int
  fare          Int
  pref          String   @default("fastest")
  createdAt     DateTime @default(now())
}

// تیکت‌های پشتیبانی (ثبت تیکت در بخش تماس با ما)
model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  contact   String // ایمیل یا شماره تماس کاربر
  category  String   @default("general") // general | bug | idea | ad
  subject   String
  message   String
  status    String   @default("open") // open | in_progress | closed
  createdAt DateTime @default(now())
}
